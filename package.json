{
  "name": "dhriti",
  "version": "1.0.0",
  "private": true,
  "description": "Dhriti - a voice-first OCD companion for India (research prototype)",
  "type": "module",
  "author": "Meenakshi Satpathy",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "eval": "tsx eval/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ml": "tsx ml/pipeline.ts",
    "lab": "tsx lab/run.ts"
  },
  "dependencies": {
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
